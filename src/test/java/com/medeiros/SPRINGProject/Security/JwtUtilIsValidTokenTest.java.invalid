        String subject = "test@example.com";
        Key secretKey = Keys.hmacShaKeyFor(mockJwtSecret.getBytes(StandardCharsets.UTF_8));
        String validToken = Jwts.builder()
                .setSubject(subject)
                .setIssuedAt(issuedAt)
                .setExpiration(expirationDate)
                .signWith(secretKey)
